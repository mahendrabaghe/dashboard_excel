# ---- Server environment (copy to server/.env for local development) ----
# Never commit the real .env file. On Render, set these in the service's Environment tab.

NODE_ENV=development
PORT=5000

# MongoDB Atlas connection string (mongodb+srv://...). Use a database user with readWrite on
# the "datapulse" database only. Local alternative: mongodb://127.0.0.1:27017/datapulse
MONGODB_URI=mongodb+srv://<db_user>:<db_password>@<cluster>.mongodb.net/datapulse?retryWrites=true&w=majority

# Long random string, at least 32 characters. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-secret-of-at-least-32-characters
JWT_EXPIRES_IN=7d

# Comma-separated list of allowed frontend origins (CORS). No trailing slash.
CLIENT_ORIGINS=http://localhost:5173,https://datapulse-web.onrender.com

# Optional: external AI provider used only by the backend for natural-language answers.
# Leave empty to use built-in local statistical insights.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

LOG_LEVEL=info
