# ---- Frontend environment (copy to client/.env.local for local development) ----
# Only VITE_* variables are embedded in the browser bundle. NEVER put secrets here.

# Base URL of the deployed API, including /api.
# Leave empty in development to use the Vite proxy (/api -> http://localhost:5000).
VITE_API_BASE_URL=https://datapulse-api.onrender.com/api
